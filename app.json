{
  "expo": {
    "name": "BirthdayBuddy",
    "slug": "birthday-buddy",
    "version": "1.0.0",
    "description": "Never forget a birthday. AI wishes, beautiful cards, and smart reminders.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "birthdaybuddy",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.birthdaybuddy.app",
      "infoPlist": {
        "NSContactsUsageDescription": "BirthdayBuddy uses your contacts to import birthdays and phone numbers.",
        "NSPhotoLibraryUsageDescription": "BirthdayBuddy lets you add photos to birthday cards and profiles.",
        "NSPhotoLibraryAddUsageDescription": "BirthdayBuddy saves your created birthday cards to your photo library.",
        "NSCameraUsageDescription": "BirthdayBuddy uses the camera for profile and card photos."
      }
    },
    "android": {
      "package": "com.birthdaybuddy.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/splash-icon.png",
          "color": "#7C3AED"
        }
      ],
      "expo-font",
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow BirthdayBuddy to import birthdays from your contacts."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "BirthdayBuddy saves and accesses photos for birthday cards.",
          "savePhotosPermission": "BirthdayBuddy saves your created birthday cards to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "appMetadata": {
        "appName": "BirthdayBuddy",
        "tagline": "Never forget a birthday again",
        "website": "https://birthdaybuddy.app",
        "supportEmail": "support@birthdaybuddy.app",
        "inviteUrlBase": "https://birthdaybuddy.app/invite"
      },
      "latestVersion": "1.0.1",
      "eas": {
        "projectId": "e1c5520d-5e5e-4d9b-8315-3652331f1017"
      }
    }
  }
}
