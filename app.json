{
  "expo": {
    "name": "BirthdayBuddy",
    "slug": "birthday-buddy-2026",
    "version": "1.0.0",
    "description": "Never forget a birthday. AI wishes, beautiful cards, and smart reminders.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "birthdaybuddy",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.birthdaybuddy.app",
      "infoPlist": {
        "NSContactsUsageDescription": "BirthdayBuddy uses your contacts to import birthdays and phone numbers.",
        "NSPhotoLibraryUsageDescription": "BirthdayBuddy lets you add photos to birthday cards and profiles.",
        "NSPhotoLibraryAddUsageDescription": "BirthdayBuddy saves your created birthday cards to your photo library.",
        "NSCameraUsageDescription": "BirthdayBuddy uses the camera for profile and card photos."
      }
    },
    "android": {
      "package": "com.birthdaybuddy.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "READ_CONTACTS",
        "USE_FULL_SCREEN_INTENT",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 180
          },
          "ios": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 180
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/splash-icon.png",
          "color": "#7C3AED"
        }
      ],
      "expo-font",
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow BirthdayBuddy to import birthdays from your contacts."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "BirthdayBuddy saves and accesses photos for birthday cards.",
          "savePhotosPermission": "BirthdayBuddy saves your created birthday cards to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.notifications.** { *; }\n-keep class com.google.android.gms.common.** { *; }\n-keep class app.notifee.core.** { *; }\n-dontwarn expo.modules.notifications.**\n-dontwarn app.notifee.**"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "appMetadata": {
        "appName": "BirthdayBuddy",
        "tagline": "Never forget a birthday again",
        "website": "https://birthdaybuddy.app",
        "supportEmail": "support@birthdaybuddy.app",
        "inviteUrlBase": "https://birthdaybuddy.app/invite"
      },
      "latestVersion": "1.0.1",
      "eas": {
        "projectId": "aeadd2a3-646c-4e7f-a0c2-7b668da26029"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/aeadd2a3-646c-4e7f-a0c2-7b668da26029"
    },
    "owner": "mailtovinay1999"
  }
}
