# Production Environment Variables
# Used for: eas build --platform android --profile production

# API Keys
EXPO_PUBLIC_OPENAI_API_KEY=your-production-openai-key

# Analytics
EXPO_PUBLIC_POSTHOG_API_KEY=your-production-posthog-key
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Environment mode
EXPO_PUBLIC_ENV=production

# Do NOT set EXPO_OFFLINE in production
# Remove or comment out for production builds
